type Hotel {
    id: ID!
    name: String!
    location: String
    rating: String
    isAvailable: Boolean
    imageUrl: String
    pricePerNight: Int
    ai_summary: String
}

input HotelInput {
    id: ID!
}


type Guest {
    id: ID!
    firstName: String!
    gender: String!
    reservations: [Reservation]
}

type Review {
    id: ID
    hotelId: ID!
    comment: String
}

type Reservation {
    id: ID!
    hotelName: String!
    location: String!
    checkInDate: String!
    checkOutDate: String!
}


type Query {
    getHotelById(id: ID!): Hotel
    getAllHotels: [Hotel]

    getGuestById(id: ID!): Guest
    getAllGuests: [Guest]

    getReviewById(id: ID!): Review
    getAllReviews: [Review]

    getReservationById(id: ID!): Reservation
    getAllReservations: [Reservation]

    getReviewsByHotelId(hotelId: ID!): [Review]
}


type Mutation {
    addHotel(
        name: String!, 
        location: String!, 
        rating: String!, 
        isAvailable: Boolean!, 
        pricePerNight: Int!,
        imageUrl: String
    ): Hotel

    updateHotelAi(
        id: ID!,
        ai_summary: String
    ): Hotel

    addGuest(
        firstName: String!, 
        gender: String!
    ): Guest

    addReview(hotelId: ID!, comment: String!): Review

    addReservation(
        hotelName: String!
        location: String!
        checkInDate: String!
        checkOutDate: String!
    ): Reservation

}
